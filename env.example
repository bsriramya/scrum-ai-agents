# Compliance Memory Agent — environment config
# Copy this file to .env and fill in your values.
# .env is in .gitignore and will never be committed.

# ── Choose ONE provider block and fill it in ──────────────────

# OPTION 1: Anthropic Claude (default)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=claude-opus-4-5

# OPTION 2: OpenAI / Codex
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-4o

# OPTION 3: GitHub Copilot / Azure OpenAI
# AZURE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# AZURE_API_BASE=https://YOUR-RESOURCE.openai.azure.com
# AZURE_API_VERSION=2024-02-15-preview
# LLM_MODEL=azure/gpt-4o

# ── Optional settings ─────────────────────────────────────────

# Max tokens per LLM response (default: 4096)
# LLM_MAX_TOKENS=4096

# Set to true to exit with code 1 on any HIGH finding (blocks CI)
# COMPLIANCE_FAIL_ON_HIGH=false
